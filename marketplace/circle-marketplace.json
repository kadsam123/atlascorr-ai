      "price_per_execution_usd": 0.75,
      "domain_tags": ["export", "compliance", "trade", "sanctions", "dual-use"],
      "input_schema": {
        "type": "object",
        "properties": {
          "product_description": {
            "type": "string",
            "description": "Plain language description of product"
          },
          "destination": {
            "type": "string",
            "description": "Destination country name or code"
          },
          "category": {
            "type": "string",
            "description": "Product category context"
          }
        },
        "required": ["product_description", "destination", "category"]
      },
      "output_example": {
        "passed": true,
        "hs_code": "9018.12",
        "sanctioned": false,
        "license_required": true,
        "license_type": "FDA Export Permit / CE Mark",
        "risk_score": 40,
        "risk_level": "MODERATE"
      }
