        "required": ["customer_name", "origin_country", "products", "target_markets"]
      },
      "output_example": {
        "customer": "Hargreaves Textiles Ltd",
        "best_route": "UK -> UAE",
        "best_market": "United Arab Emirates",
        "tariff_rate": 5,
