        "required": ["company_name", "product", "origin", "target_market"]
      },
      "output_example": {
        "executive_summary": "Summary...",
        "estimated_costs": {
          "logistics": 3200,
          "compliance": 800,
          "tariffs": 0,
          "total": 4000
        }
      }
    },
    {
      "id": "full-pipeline-agent",
      "name": "Full Pipeline Agent",
      "tagline": "Run the complete 5-step export intelligence pipeline.",
      "description": "Aggregates the processing of Ingestion, Routing, Market Matching, Compliance, and CircleBrain Orchestration into a single comprehensive output.",
      "endpoint": "https://atlascorr-agent-api-production.up.railway.app/api/pipeline",
      "method": "POST",
      "price_per_execution_usd": 5.00,
      "domain_tags": ["export", "compliance", "logistics", "trade", "orchestration"],
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_name": { "type": "string" },
          "origin_country": { "type": "string" },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "category": { "type": "string" },
                "hs_code": { "type": "string" }
              }
            }
          },
          "target_markets": { "type": "array", "items": { "type": "string" } },
