      "output_example": {
        "opportunities": [
          {
            "market": "Singapore",
            "score": 94,
            "tariff": 0,
            "region": "SE Asia"
          }
        ],
        "total": 15
      }
    },
    {
      "id": "compliance-agent",
      "name": "Compliance Agent",
      "tagline": "Full DDTRS compliance, sanctions, and dual-use checks.",
      "description": "Validates products and destinations against sanctions lists, active trade dual-use conditions, and license requirements, generating a 0-100 risk score.",
