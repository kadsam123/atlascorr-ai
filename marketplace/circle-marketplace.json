{
  "marketplace_name": "Circle Agent Stack",
  "version": "1.0.0",
  "publisher": "AtlasCorr AI",
  "publisher_url": "https://kadsam123.github.io/atlascorr-ai/",
  "pricing_url": "https://kadsam123.github.io/atlascorr-ai/pricing.html",
  "upsell_global": {
    "message": "Upgrade to AtlasCorr AI for unlimited daily pipeline runs and proactive monitoring.",
    "upgrade_url": "https://kadsam123.github.io/atlascorr-ai/pricing.html"
  },
  "agents": [
    {
      "id": "hs-code-agent",
      "name": "HS Code Agent",
      "tagline": "Turn any product description into a globally-recognised tariff code in seconds.",
      "description": "Uses large-language-model reasoning combined with a curated Harmonised System (HS) ontology to extract the correct 6-digit (or country-extended 8-10 digit) HS code from free-text product descriptions.",
      "endpoint": "https://atlascorr-agent-api-production.up.railway.app/api/hs-code",
      "method": "POST",
      "price_per_execution_usd": 0.10,
      "domain_tags": ["export", "compliance", "trade", "hs-code", "classification"],
      "input_schema": {
        "type": "object",
        "properties": {
          "product_description": {
            "type": "string",
            "description": "Plain language description of the product"
          }
        },
        "required": ["product_description"]
      },
      "output_example": {
        "request_id": "f4a65020-ca0a-405e-a5db-bca27728e94b",
        "hs_code": "0910.30",
        "confidence": 0.72,
        "category": "food",
        "description": "Turmeric (curcuma)",
        "source": "DDTRS"
      }
    },
    {
      "id": "tariff-agent",
      "name": "Tariff Agent",
      "tagline": "Instant duty rates for any HS code and destination country.",
      "description": "Retrieves current import duty rates, VAT/GST rates, and applicable trade preference rates for any HS code exported to a specific destination country.",
      "endpoint": "https://atlascorr-agent-api-production.up.railway.app/api/tariff",
      "method": "POST",
      "price_per_execution_usd": 0.20,
      "domain_tags": ["export", "trade", "tariff", "taxes", "landed-cost"],
      "input_schema": {
        "type": "object",
        "properties": {
          "hs_code": {
            "type": "string",
            "description": "6-digit HS commodity code"
          },
          "destination_code": {
            "type": "string",
            "description": "3-letter ISO country code (e.g., UAE, SGP, IND)"
          },
          "category": {
            "type": "string",
            "description": "Product category: textiles, food, machinery, electronics, medical"
          }
        },
        "required": ["hs_code", "destination_code"]
      },
      "output_example": {
        "tariff_rate": 5,
        "destination": "UAE",
        "category": "textiles",
        "hs_code": "6117.10",
        "currency": "percent",
        "source": "TradeMatch"
      }
    },
    {
      "id": "route-agent",
      "name": "Route Agent",
      "tagline": "Score and rank trade corridors for any origin-destination pair.",
      "description": "Scores global trade corridors on cost index, transit time, port efficiency, and political risk, surfacing the best route recommendations.",
      "endpoint": "https://atlascorr-agent-api-production.up.railway.app/api/route",
      "method": "POST",
      "price_per_execution_usd": 0.50,
      "domain_tags": ["export", "logistics", "trade", "routing", "shipping"],
      "input_schema": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "description": "Origin country code"
          },
          "destination": {
            "type": "string",
            "description": "Destination country code"
          },
          "product_category": {
            "type": "string",
            "description": "Product category context"
          }
        },
        "required": ["origin", "destination"]
      },
      "output_example": {
        "routes": [
          {
            "name": "UK -> UAE",
            "score": 87,
            "transit_days": 9,
            "cost_index": 3.2,
            "port_efficiency": 94,
            "political_risk": "LOW"
          }
        ],
        "best_route": {
          "name": "UK -> UAE",
          "score": 87
        }
      }
    },
    {
      "id": "market-agent",
      "name": "Market Match Agent",
      "tagline": "Match products to markets using multi-factor opportunity scoring.",
      "description": "Matches a product category to target markets by evaluating ease of trade, tariff exposure, import growth, and GDP trajectory.",
      "endpoint": "https://atlascorr-agent-api-production.up.railway.app/api/market",
      "method": "POST",
      "price_per_execution_usd": 0.50,
      "domain_tags": ["export", "trade", "market-match", "opportunities", "sales"],
      "input_schema": {
        "type": "object",
        "properties": {
          "product_category": {
            "type": "string",
            "description": "Product category: textiles, food, machinery, electronics, medical"
          },
          "target_markets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of destination country codes to compare"
          }
        },
        "required": ["product_category"]
      },
      "output_example": {
        "matches": [
          {
            "market": "Singapore",
            "score": 94,
            "tariff": 0,
            "import_growth": 6.1
          }
        ],
        "best_market": "Singapore"
      }
    },
    {
      "id": "opportunity-agent",
